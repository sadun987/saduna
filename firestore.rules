rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidConversation(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.mode is string && data.mode in ['chat', 'generate', 'debug', 'explain', 'project'] &&
             data.language is string && data.language.size() >= 1 && data.language.size() <= 40 &&
             data.modelName is string && data.modelName.size() >= 1 && data.modelName.size() <= 80 &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 240 &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMessage(data, conversationId) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.conversationId is string && data.conversationId == conversationId &&
             data.role is string && data.role in ['user', 'model'] &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 60000 &&
             data.language is string && data.language.size() <= 40 &&
             data.toolMode is string && data.toolMode in ['chat', 'generate', 'debug', 'explain', 'project'] &&
             data.sequenceOrder is int && data.sequenceOrder >= 0 && data.sequenceOrder <= 100000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSnippet(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 120 &&
             data.language is string && data.language.size() >= 1 && data.language.size() <= 40 &&
             data.code is string && data.code.size() <= 100000 &&
             data.summary is string && data.summary.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/conversations/{conversationId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(conversationId);

      allow create: if isOwner(userId) &&
                       isValidId(conversationId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'mode', 'language', 'modelName',
                         'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'mode', 'language', 'modelName',
                         'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidConversation(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(conversationId) &&
                       isValidConversation(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'mode', 'language', 'modelName',
                         'lastMessagePreview', 'messageCount', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(conversationId);

      match /messages/{messageId} {
        allow list: if isOwner(userId) && isValidId(conversationId);
        allow get: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);

        allow create: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         isValidId(messageId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId)) &&
                         incoming().keys().hasAll([
                           'userId', 'conversationId', 'role', 'content',
                           'language', 'toolMode', 'sequenceOrder', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'conversationId', 'role', 'content',
                           'language', 'toolMode', 'sequenceOrder', 'createdAt'
                         ]) &&
                         isValidMessage(incoming(), conversationId);

        allow update: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         isValidId(messageId) &&
                         isValidMessage(incoming(), conversationId) &&
                         incoming().userId == existing().userId &&
                         incoming().conversationId == existing().conversationId &&
                         incoming().role == existing().role &&
                         incoming().sequenceOrder == existing().sequenceOrder &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['content']);

        allow delete: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
      }
    }

    match /users/{userId}/snippets/{snippetId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(snippetId);

      allow create: if isOwner(userId) &&
                       isValidId(snippetId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'fileName', 'language',
                         'code', 'summary', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'fileName', 'language',
                         'code', 'summary', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidSnippet(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(snippetId) &&
                       isValidSnippet(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'fileName', 'language', 'code', 'summary', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(snippetId);
    }
  }
}
